# ==============================================================================
# CONSIGLIERE HOLDINGS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Transactional Email Provider API Key (Resend)
# ------------------------------------------------------------------------------
# Obtain your server-side API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_server_side_api_key

# Recipient Address for Commercial Enquiries
ENQUIRY_TO_EMAIL=info@consigliereholdings.com

# Verified Outgoing Sender Address
# - Sandbox evaluation: Consigliere Commercial Desk <onboarding@resend.dev>
# - Production verified domain: Consigliere Commercial Desk <enquiries@consigliereholdings.com>
ENQUIRY_FROM_EMAIL=Consigliere Commercial Desk <onboarding@resend.dev>

# Runtime Environment (development | production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Firebase Client Configuration (Admin Portal & Firestore)
# ------------------------------------------------------------------------------
# Obtain these values from your Firebase Project Console:
# https://console.firebase.google.com/
# Project Settings > General > Your Apps > Web App Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
