# ==============================================================================
# CONSIGLIERE HOLDINGS - COMMERCIAL ENQUIRY SYSTEM CONFIGURATION
# ==============================================================================

# 1. Transactional Email Provider API Key (Resend)
# Obtain your server-side API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_server_side_api_key

# 2. Recipient Address for Commercial Enquiries
# The commercial inbox where all counterparty requirement notifications will be delivered
ENQUIRY_TO_EMAIL=info@consigliereholdings.com

# 3. Verified Outgoing Sender Address
# Notes on domain verification:
# - For local testing & sandbox evaluation (before DNS verification):
#   Use Resend's default sandbox sender:
#   ENQUIRY_FROM_EMAIL=Consigliere Commercial Desk <onboarding@resend.dev>
# - In production (once consigliereholdings.com is verified with DKIM/SPF in Resend):
#   Use your branded domain sender:
#   ENQUIRY_FROM_EMAIL=Consigliere Commercial Desk <enquiries@consigliereholdings.com>
ENQUIRY_FROM_EMAIL=Consigliere Commercial Desk <onboarding@resend.dev>

# 4. Runtime Environment (development | production)
NODE_ENV=development
